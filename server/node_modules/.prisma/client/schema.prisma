generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         String   @default("customer") // customer | admin
  createdAt    DateTime @default(now())

  orders        Order[]
  subscriptions Subscription[]
  tickets       SupportTicket[]
}

model HostingPlan {
  id           String  @id @default(uuid())
  type         String // static | vps
  name         String
  storageGb    Int?
  websiteLimit Int? // null = unlimited
  vcpu         Int?
  ramGb        Int?
  bandwidthTb  Int?
  priceMonthly Float
  price1Year   Float?
  price2Year   Float?
  price3Year   Float?
  isActive     Boolean @default(true)

  orders        Order[]
  subscriptions Subscription[]
}

model Order {
  id           String   @id @default(uuid())
  userId       String
  planId       String
  status       String // pending | paid | failed | refunded
  amount       Float
  billingCycle String // monthly | yearly
  createdAt    DateTime @default(now())

  user User        @relation(fields: [userId], references: [id])
  plan HostingPlan @relation(fields: [planId], references: [id])

  subscriptions Subscription[]
  payments      Payment[]
  invoices      Invoice[]
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  orderId   String
  status    String // active | expiring | expired | cancelled
  startDate DateTime @default(now())
  endDate   DateTime
  autoRenew Boolean  @default(true)

  user  User        @relation(fields: [userId], references: [id])
  plan  HostingPlan @relation(fields: [planId], references: [id])
  order Order       @relation(fields: [orderId], references: [id])

  websites     Website[]
  vpsInstances VpsInstance[]
}

model Payment {
  id               String    @id @default(uuid())
  orderId          String
  gateway          String
  gatewayPaymentId String?
  amount           Float
  status           String
  paidAt           DateTime?

  order Order @relation(fields: [orderId], references: [id])
}

model Website {
  id             String  @id @default(uuid())
  subscriptionId String
  domainName     String?
  storageUsedMb  Int     @default(0)
  status         String  @default("active")

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}

model VpsInstance {
  id                   String    @id @default(uuid())
  subscriptionId       String
  ipAddress            String?
  status               String    @default("provisioning") // provisioning | active | suspended
  provisionedByAdminAt DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  subject   String
  message   String
  status    String   @default("open") // open | closed
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String
  invoiceNumber String   @unique
  pdfUrl        String?
  issuedAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}
